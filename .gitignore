# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and editor files
*.swp
*.swo
*~
*.tmp
*.bak

# Operating System specific files
.DS_Store
Thumbs.db
desktop.ini

# Local execution logs & transient runtime artifacts
logs/execution/*.log
!logs/**/.gitkeep
!reports/**/.gitkeep
!case-output/**/.gitkeep

# Sensitive local secrets & credentials
.vault_pass*
